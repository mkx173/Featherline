<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="hrt_tracker.db" />
        <exclude domain="database" path="hrt_tracker.db-shm" />
        <exclude domain="database" path="hrt_tracker.db-wal" />
        <exclude domain="sharedpref" path="hrt_tracker_secure_storage.xml" />
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/home_snapshot.pb" />
        <exclude domain="file" path="datastore/widget_snapshot.pb" />
        <exclude domain="file" path="datastore/home_snapshot_metadata.preferences_pb" />
        <exclude domain="file" path="datastore/reminder_schedule.preferences_pb" />
        <exclude domain="file" path="datastore/medication_reminder_snoozes.preferences_pb" />
        <exclude domain="file" path="diagnostics" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="hrt_tracker.db" />
        <exclude domain="database" path="hrt_tracker.db-shm" />
        <exclude domain="database" path="hrt_tracker.db-wal" />
        <exclude domain="sharedpref" path="hrt_tracker_secure_storage.xml" />
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/home_snapshot.pb" />
        <exclude domain="file" path="datastore/widget_snapshot.pb" />
        <exclude domain="file" path="datastore/home_snapshot_metadata.preferences_pb" />
        <exclude domain="file" path="datastore/reminder_schedule.preferences_pb" />
        <exclude domain="file" path="datastore/medication_reminder_snoozes.preferences_pb" />
        <exclude domain="file" path="diagnostics" />
    </device-transfer>
</data-extraction-rules>
