<?xml version="1.0" encoding="utf-8"?>
<!-- minResize* are dp floors the launcher divides by the device's real cell size, not
     cell counts. Cells measure ~95dp wide, so 140dp and 190dp both floored this widget
     at 2 columns; 210dp is the first value that clears two of them. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="210dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/hrt_widget_large_preview"
    android:previewImage="@drawable/widget_preview_large"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_large_description" />
