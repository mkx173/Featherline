<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <exclude domain="database" path="hrt_tracker.db" />
    <exclude domain="database" path="hrt_tracker.db-shm" />
    <exclude domain="database" path="hrt_tracker.db-wal" />
    <exclude domain="sharedpref" path="hrt_tracker_secure_storage.xml" />
    <exclude domain="file" path="datastore/settings.preferences_pb" />
    <exclude domain="file" path="datastore/home_snapshot.pb" />
    <exclude domain="file" path="datastore/home_snapshot_metadata.preferences_pb" />
</full-backup-content>
