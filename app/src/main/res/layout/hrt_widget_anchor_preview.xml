<?xml version="1.0" encoding="utf-8"?>
<!--
  Static appwidget-provider previewLayout used by Android 12–14 (API 31–34)
  widget pickers. API 35+ uses providePreview() in AnchorWidget.kt instead.
  Sample data mirrors anchorPreviewAnchor() ("HRT", since Jan 1 2026, 67 days,
  default event icon, no gradient) — keep them in sync. Interior text sizes are
  pre-scaled by WIDGET_PREVIEW_CONTENT_SCALE (0.6×) to match the Compose
  preview (live 20/16/30sp → 12/10/18sp); the outer shell (22dp corners, 12dp
  padding) and the glyph watermark stay unscaled, matching the live widget
  where the backdrop is card-relative, not content-scaled. The watermark
  mirrors the live geometry (AnchorWatermark.kt: glyph = 1.1× card height,
  20% bled off the top/end edges) at the preview scale — 0.88 × 138dp
  reference × 0.6 = 72dp visible, drawn as a 90dp glyph with -18dp top/end
  margins, cropped by the clipping parent. If a picker's inflation ignores
  negative margins the glyph renders flush top-end instead — same
  proportion, just without the bleed.
-->
<!-- RemoteViews layout: framework ImageView ignores app:tint, so android:tint
     is required; UseAppTint is a false positive (suppressed file-wide). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UseAppTint"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_shell_bg"
    android:clipToOutline="true">

    <ImageView
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-18dp"
        android:layout_marginEnd="-18dp"
        android:src="@drawable/ic_event"
        android:tint="@color/widget_preview_primary"
        android:alpha="0.12"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/anchor_widget_preview_name"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/anchor_widget_preview_since"
            android:textColor="@color/widget_preview_on_surface_variant"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:text="@string/anchor_widget_preview_days"
        android:textColor="@color/widget_preview_on_surface"
        android:textSize="18sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1" />
</FrameLayout>
