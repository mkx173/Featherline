<?xml version="1.0" encoding="utf-8"?>
<!--
  Segmented progress ring mirroring ProgressRing in WidgetRows.kt for the sample
  1/3-done preview: three ~96° arcs (120° each minus a gap) starting at the top,
  going clockwise. The first segment is "done" (primary); the other two are the
  track (outlineVariant). Center (12,12), centerline radius 10.5, 3dp round-cap
  stroke. Keep in sync with previewSnapshot()'s doneCount / totalCount (1 / 3).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Track: segments 2 and 3 of 3 (bottom, then left). -->
    <path
        android:strokeColor="@color/widget_preview_outline_variant"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M19.80,19.03 A10.5,10.5 0 0 1 4.20,19.03" />
    <path
        android:strokeColor="@color/widget_preview_outline_variant"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M2.01,15.24 A10.5,10.5 0 0 1 9.82,1.73" />
    <!-- Done: segment 1 of 3 (top-right). -->
    <path
        android:strokeColor="@color/widget_preview_primary"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M14.18,1.73 A10.5,10.5 0 0 1 21.99,15.24" />
</vector>
